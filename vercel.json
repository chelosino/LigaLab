{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/league",
      "destination": "/api/index?route=league"
    },
    {
      "source": "/api/leagues",
      "destination": "/api/index?route=leagues"
    },
    {
      "source": "/api/matches.csv",
      "destination": "/api/index?route=matches.csv"
    },
    {
      "destination": "/admin.html",
      "source": "/admin"
    },
    {
      "destination": "/api/index?route=auth-config",
      "source": "/api/auth-config"
    },
    {
      "destination": "/api/index?route=admin/:action",
      "source": "/api/admin/:action"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
